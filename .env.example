# Health and catalog run without credentials. Copy to .env for local configuration.
APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Backend-only parser credentials; optional for health/catalog startup.
OPENAI_API_KEY=
OPENAI_MODEL=
# Database integration remains pending; never commit real credentials.
DATABASE_URL=
# Backend-only Sandbox adapter; optional until checkout integration. Live URLs rejected.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Public client ID only, reserved for buyer UI. Never add a public client SECRET.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
