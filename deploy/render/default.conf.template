server {
    listen ${PORT};
    server_tokens off;
    client_max_body_size 64k;
    client_body_timeout 10s;
    location / {
        proxy_pass http://${FRONTEND_HOSTPORT};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # Conservative socket identity: never trust browser-supplied forwarded IPs.
        # Render edge peers can share this key; hosted demo is private, not public auth.
        proxy_set_header X-Ryuk-Client-IP $remote_addr;
        proxy_set_header X-Ryuk-Proxy-Token "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 40s;
    }
}
